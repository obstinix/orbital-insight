{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "assets:download": {
      "cache": true,
      "outputs": ["apps/web/public/textures/**", "apps/web/public/stars/**", "apps/web/public/constellations/**"]
    },
    "assets:process": {
      "dependsOn": ["assets:download"],
      "cache": true
    }
  }
}
